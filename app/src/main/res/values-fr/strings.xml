    <string name="help_title">Guide</string>
    <string name="help_subtitle">Opérations tactile et stylet</string>
    <string name="help_pen_section">Stylet</string>
    <string name="help_pen_hover">Survoler : notes fantômes et note ciblée surlignées.</string>
    <string name="help_pen_drag_empty">Glisser sur du vide : dessine une note de cette longueur, posée au relâcher.</string>
    <string name="help_pen_drag_note_center">Glisser le centre d\'une note : déplace toutes les notes sélectionnées.</string>
    <string name="help_pen_drag_note_edge">Glisser les bords d\'une note : change sa longueur (détection avec hystérésis).</string>
    <string name="help_pen_double_tap">Double-toucher une note : la supprime (annulable).</string>
    <string name="help_pen_numeric">Édition numérique : sélectionnez des notes, ouvrez « Édition numérique ».</string>
    <string name="help_pen_eraser">Gomme du stylet : supprime les notes touchées.</string>
    <string name="help_finger_section">Doigt</string>
    <string name="help_finger_tap">Toucher le vide : ajoute une note de la longueur actuelle.</string>
    <string name="help_finger_drag">Glisser le vide : défile dans la direction initiale (axe verrouillé).</string>
    <string name="help_finger_pinch">Deux doigts : défilement et zoom temps/hauteur.</string>
    <string name="help_finger_long_empty">Appui long sur le vide : sélection rectangulaire multi-notes.</string>
    <string name="help_finger_long_note">Appui long sur une note : ajoute / retire de la sélection.</string>
    <string name="help_finger_note_drag">Glisser une note : déplacer ; les bords redimensionnent.</string>
    <string name="help_ruler">Toucher / glisser la règle : déplacer la lecture.</string>
    <string name="help_loop_band">La bande de boucle sous la règle : glisser pour définir la boucle.</string>
    <string name="help_vel_section">Éditeur de vélocité / multi-sélection</string>
    <string name="help_vel_open">« Éditeur de vélocité » superpose un graphe de vélocité au rouleau.</string>
    <string name="help_vel_drag">Faites glisser les nœuds verticalement pour changer la vélocité.</string>
    <string name="help_vel_multi">Plusieurs notes sélectionnées : leurs nœuds bougent ensemble.</string>
    <string name="help_multiselect_on">« Multi-sélection » activé : glisser pour sélectionner, toucher pour ajouter/retirer.</string>
    <string name="help_multiselect_pause">En multi-sélection, déplacement/retaille en pause. Désactivez le bouton ensuite.</string>
    <string name="help_toolbar_section">Barre d\'outils</string>
    <string name="help_toolbar_selected">Notes sélectionnées : longueur, vélocité, transposition, dupliquer, copier, couper, supprimer, quantifier, boucle.</string>
    <string name="help_toolbar_unselected">Rien de sélectionné : grille, longueur d\'entrée, aimant, vélocité d\'entrée, tout quantifier, tout sélectionner.</string>
    <string name="help_toolbar_zoom">Zoom avant/arrière/total agissent sur temps et hauteur.</string>
    <string name="help_align_v">« Aligner la vélocité » met toutes les notes à la même vélocité.</string>
    <string name="help_save_section">Sauvegarde &amp; MIDI</string>
    <string name="help_autosave_tabs">Les projets sont sauvegardés ; plusieurs onglets restent ouverts.</string>
    <string name="help_browser">Ouvrir, renommer, supprimer les projets via « Ouvrir un projet ».</string>
    <string name="help_export_saf">L\'export MIDI va vers une destination Storage Access Framework.</string>
    <string name="help_share">« Partager » envoie le .mid vers les cibles Android (mail, cloud…).</string>
    <string name="help_track_preserved">Les autres pistes d\'un MIDI importé conservent leurs événements à l\'export.</string>
    <string name="help_meta">Éditez copyright, tonalité, compositeur… dans « Réglages MIDI META ».</string>
    <string name="help_soundfont_settings">Choisissez un SF2 dans Paramètres &gt; Son. Le fichier est stocké dans l\'app et réutilisé.</string>
    <string name="help_new_project_confirm">Les modifications en cours écrasent la sauvegarde auto. Exportez d\'abord si besoin.</string>
    <string name="help_soundfont_library">Les SoundFonts importés sont gérés dans la bibliothèque, attribuables à toute piste.</string>
    <string name="help_kb_section">Jouer avec un clavier physique</string>
    <string name="help_kb_row1">A S D F G H J K = C4..B4 ; W E T Y U = dièses.</string>
    <string name="help_kb_row2">K O L P ; = une octave plus haut. Z / X : octave -1 / +1 (-2..+2).</string>
    <string name="help_kb_record">Les notes durent autant que les touches (enregistre si l\'entrée MIDI est armée, sinon écoute seule).</string>
    <string name="help_kb_stopped">Même à l\'arrêt, les notes se placent dans l\'ordre joué.</string>
    <string name="help_sc_section">Raccourcis clavier</string>
    <string name="help_sc_space">Espace : lecture/pause. R : armer l\'entrée MIDI. Ctrl+L : boucle. Échap : stop/désélection.</string>
    <string name="help_sc_undo">Ctrl+Z / Ctrl+Shift+Z : annuler / rétablir. Ctrl+C / X / V : copier / couper / coller.</string>
    <string name="help_sc_misc">Ctrl+A : tout sélectionner. Ctrl+D : dupliquer. Suppr : supprimer la sélection. Ctrl+S : enregistrer. Ctrl+Shift+S : partager.</string>
    <string name="help_sc_arrows">Flèches : déplacer / transposer la sélection (Maj = octave) ; sinon déplacer la lecture par pas de grille.</string>
    <string name="help_sc_zoom">Ctrl+Tab : onglets. Ctrl+= / Ctrl+- / Ctrl+0 : zoom / tout. Début : aller au début.</string>
    <string name="help_midi_section">Entrée clavier MIDI</string>
    <string name="help_midi_auto">Les claviers USB / Bluetooth LE MIDI se connectent automatiquement.</string>
    <string name="help_midi_arm">Armez l\'entrée MIDI avec R puis jouez (à l\'arrêt, notes dans l\'ordre depuis la position).</string>
    <string name="help_midi_pedal">Armé : la pédale (CC64) est aussi enregistrée et jouée.</string>
