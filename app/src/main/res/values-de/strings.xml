    <string name="help_kb_row1">A S D F G H J K = C4..B4; W E T Y U = Vorzeichen.</string>
    <string name="help_kb_row2">K O L P ; eine Oktave höher. Z / X: Oktave runter / hoch (-2..+2).</string>
