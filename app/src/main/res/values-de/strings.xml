    <string name="help_sc_misc">Strg+A: alles. Strg+D: duplizieren. Entf: Auswahl löschen. Strg+S: sichern. Strg+Umschalt+S: teilen.</string>
    <string name="help_sc_arrows">Pfeile: Auswahl verschieben / transponieren (Umschalt = Oktave); sonst Abspielposition rasterschrittweise.</string>
    <string name="help_sc_zoom">Strg+Tab: Tabwechsel. Strg+= / Strg+- / Strg+0: Zoom / alles. Home: zum Anfang.</string>
