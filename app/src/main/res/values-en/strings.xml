    <string name="help_title">User guide</string>
    <string name="help_subtitle">Touch and stylus operations</string>
    <string name="help_pen_section">Pen (stylus)</string>
    <string name="help_pen_hover">Hover the pen: ghost notes and the target note are highlighted.</string>
    <string name="help_pen_drag_empty">Drag on empty space: draw a note of that length. It is placed when you lift.</string>
    <string name="help_pen_drag_note_center">Drag a note\'s center: moves all selected notes together.</string>
    <string name="help_pen_drag_note_edge">Drag a note\'s edges: change its length. Edge detection has hysteresis.</string>
    <string name="help_pen_double_tap">Double-tap a note: deletes it. Undo restores it.</string>
    <string name="help_pen_numeric">Numeric editing: select notes, open "Numeric edit" in the bottom toolbar.</string>
    <string name="help_pen_eraser">Pen eraser: deletes notes it touches.</string>
    <string name="help_finger_section">Finger</string>
    <string name="help_finger_tap">Tap empty space: adds a note of the current length.</string>
    <string name="help_finger_drag">Drag empty space: scrolls in the direction you first moved (axis locked).</string>
    <string name="help_finger_pinch">Two fingers: scroll and pinch-zoom of time and pitch.</string>
    <string name="help_finger_long_empty">Long-press empty space: rectangle-select multiple notes.</string>
    <string name="help_finger_long_note">Long-press a note: add to / remove from the selection.</string>
    <string name="help_finger_note_drag">Drag a note: move it; drag its edges to resize.</string>
    <string name="help_ruler">Tap / drag the ruler: move the playhead.</string>
    <string name="help_loop_band">The loop band under the ruler: drag to set the loop range.</string>
    <string name="help_vel_section">Velocity editor / multi-select</string>
    <string name="help_vel_open">"Velocity editor" in the bottom toolbar overlays a velocity graph on the roll.</string>
    <string name="help_vel_drag">Drag nodes on the graph up/down to change that note\'s velocity.</string>
    <string name="help_vel_multi">With multiple notes selected, their nodes move together.</string>
    <string name="help_multiselect_on">With "Multi-select" on, drag to range-select and tap notes to add / remove them.</string>
    <string name="help_multiselect_pause">While multi-select is on, moving/resizing notes is paused. Turn the button off when done.</string>
    <string name="help_toolbar_section">Bottom toolbar</string>
    <string name="help_toolbar_selected">When notes are selected: length, velocity, transpose, duplicate, copy, cut, delete, quantize, loop range.</string>
    <string name="help_toolbar_unselected">With nothing selected: grid, input length, snap, input velocity, quantize all, select all.</string>
    <string name="help_toolbar_zoom">Zoom in / out / fit affect both the time and pitch axes.</string>
    <string name="help_align_v">"Match velocity" sets all selected notes to one velocity.</string>
    <string name="help_save_section">Saving &amp; MIDI</string>
    <string name="help_autosave_tabs">Projects autosave; several can stay open in tabs.</string>
    <string name="help_browser">Open, rename and delete saved projects from "Open project".</string>
    <string name="help_export_saf">MIDI export goes to a Storage Access Framework destination.</string>
    <string name="help_share">"Share" sends the exported .mid to Android share targets (mail, cloud, …).</string>
    <string name="help_track_preserved">Other tracks of an imported MIDI keep their untouched events on export.</string>
    <string name="help_meta">Edit copyright, key, composer and other text in "MIDI META settings".</string>
    <string name="help_soundfont_settings">Pick a device SF2 file in Settings &gt; Sound. The chosen file is stored in the app and reused on next launch.</string>
    <string name="help_new_project_confirm">Current edits overwrite the autosave. Export MIDI first if needed.</string>
    <string name="help_soundfont_library">Imported SoundFonts are managed centrally in the library and assignable to any track.</string>
    <string name="help_kb_section">Play with a physical keyboard</string>
    <string name="help_kb_row1">A S D F G H J K are C4..B4; W E T Y U are the sharps.</string>
    <string name="help_kb_row2">K O L P ; are one octave up. Z / X shift the octave down / up (-2..+2).</string>
    <string name="help_kb_record">Notes record for exactly as long as you hold keys (records while MIDI input is armed; otherwise just auditions).</string>
    <string name="help_kb_stopped">Even when stopped, notes land sequentially in time as you play them.</string>
    <string name="help_sc_section">Keyboard shortcuts</string>
    <string name="help_sc_space">Space: play/pause. R: arm MIDI input. Ctrl+L: loop. Esc: stop/deselect.</string>
    <string name="help_sc_undo">Ctrl+Z / Ctrl+Shift+Z: undo / redo. Ctrl+C / X / V: copy / cut / paste.</string>
    <string name="help_sc_misc">Ctrl+A: select all. Ctrl+D: duplicate. Delete: delete selection. Ctrl+S: save. Ctrl+Shift+S: share.</string>
    <string name="help_sc_arrows">Arrows: move / transpose selection (Shift = octave); with nothing selected, move the playhead by grid steps.</string>
    <string name="help_sc_zoom">Ctrl+Tab: switch tabs. Ctrl+= / Ctrl+- / Ctrl+0: zoom / fit. Home: go to start.</string>
    <string name="help_midi_section">MIDI keyboard input</string>
    <string name="help_midi_auto">USB / Bluetooth LE MIDI keyboards connect automatically.</string>
    <string name="help_midi_arm">Arm MIDI input with R, then play to record (stopped, notes land sequentially from where you are).</string>
    <string name="help_midi_pedal">While armed, the damper pedal (CC64) is recorded and played too.</string>
