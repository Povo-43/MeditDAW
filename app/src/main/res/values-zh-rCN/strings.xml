    <string name="help_pen_section">笔（触控笔）</string>
    <string name="help_pen_hover">悬停笔尖：显示幽灵音符并高亮目标音符。</string>
    <string name="help_pen_drag_empty">空白处拖动：绘制音符长度并添加。松开时确定。</string>
    <string name="help_pen_drag_note_center">拖动音符中央：整体移动选中音符。</string>
    <string name="help_pen_drag_note_edge">拖动音符左右端：更改长度。端点判定有滞回。</string>
    <string name="help_pen_double_tap">双击音符：删除该音符。可撤销恢复。</string>
    <string name="help_pen_numeric">数值编辑：选择音符，打开底部工具栏的“数值编辑”。</string>
    <string name="help_pen_eraser">笔的橡皮擦：删除触碰到的音符。</string>
    <string name="help_finger_section">手指</string>
    <string name="help_finger_tap">点击空白处：以当前长度添加音符。</string>
    <string name="help_finger_drag">空白处拖动：沿最初移动的方向滚动（轴锁定）。</string>
    <string name="help_finger_pinch">双指：滚动及时间、音高缩放。</string>
    <string name="help_finger_long_empty">长按空白处：矩形选择多个音符。</string>
    <string name="help_finger_long_note">长按音符：加入/移出选择。</string>
    <string name="help_finger_note_drag">拖动音符：移动。拖动端点改变长度。</string>
    <string name="help_ruler">点击/拖动标尺：移动播放位置。</string>
    <string name="help_loop_band">标尺下方的循环带：拖动设定循环范围。</string>
    <string name="help_vel_section">力度编辑 / 多选</string>
    <string name="help_vel_open">底部工具栏的“力度编辑”会在钢琴卷帘下部叠加力度图。</string>
    <string name="help_vel_drag">上下拖动图上节点以更改该音符力度。</string>
    <string name="help_vel_multi">选中多个音符时，所选节点会一起移动。</string>
    <string name="help_multiselect_on">开启“多选”后，拖动范围选择，点击音符加入/移出。</string>
    <string name="help_multiselect_pause">多选期间暂停音符移动/长度调整。完成后请关闭按钮。</string>
    <string name="help_toolbar_section">底部工具栏</string>
    <string name="help_toolbar_selected">选中时可用：长度、力度、移调、复制副本、复制、剪切、删除、量化、循环范围。</string>
    <string name="help_toolbar_unselected">未选择时可用：网格、输入长度、吸附、输入力度、全部量化、全选。</string>
    <string name="help_toolbar_zoom">放大/缩小/全览同时作用于时间和音高轴。</string>
    <string name="help_align_v">“统一力度”将选中音符的力度设为相同值。</string>
    <string name="help_save_section">保存与MIDI</string>
